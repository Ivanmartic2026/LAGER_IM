{
  "name": "SupplierDocumentRequest",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "Referens till artikel"
    },
    "article_name": {
      "type": "string",
      "description": "Artikelnamn"
    },
    "article_batch_number": {
      "type": "string",
      "description": "Batch nummer"
    },
    "supplier_id": {
      "type": "string",
      "description": "Referens till leverant\u00f6r"
    },
    "supplier_name": {
      "type": "string",
      "description": "Leverant\u00f6rens namn"
    },
    "request_token": {
      "type": "string",
      "description": "Unik token f\u00f6r uppladdningsl\u00e4nk"
    },
    "document_image_url": {
      "type": "string",
      "description": "URL till genererat dokumentbild (PNG)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "documents_uploaded",
        "completed"
      ],
      "default": "pending",
      "description": "Status p\u00e5 beg\u00e4ran"
    },
    "uploaded_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs till uppladdade dokument fr\u00e5n leverant\u00f6r"
    },
    "upload_notes": {
      "type": "string",
      "description": "Anteckningar fr\u00e5n leverant\u00f6r"
    }
  },
  "required": [
    "article_id",
    "request_token"
  ]
}