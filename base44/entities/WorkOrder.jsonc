{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Referens till Order"
    },
    "order_number": {
      "type": "string",
      "description": "Ordernummer (kopierat fr\u00e5n Order)"
    },
    "name": {
      "type": "string",
      "description": "Arbetsordens namn/titel"
    },
    "customer_name": {
      "type": "string",
      "description": "Kundnamn (kopierat fr\u00e5n Order)"
    },
    "customer_reference": {
      "type": "string",
      "description": "Kundreferens"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Leveransdatum (kopierat fr\u00e5n Order)"
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "picking",
        "production",
        "delivery",
        "completed"
      ],
      "default": "picking",
      "description": "Nuvarande fas i arbetsordern"
    },
    "status": {
      "type": "string",
      "enum": [
        "v\u00e4ntande",
        "p\u00e5g\u00e5r",
        "klar",
        "avbruten"
      ],
      "default": "v\u00e4ntande",
      "description": "\u00d6vergripande status"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          },
          "assigned_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "v\u00e4ntande",
              "p\u00e5g\u00e5r",
              "klar"
            ],
            "default": "v\u00e4ntande"
          },
          "type": {
            "type": "string",
            "enum": [
              "k\u00f6p",
              "tillverka",
              "montera"
            ],
            "default": "montera",
            "description": "Typ av arbetsmoment"
          },
          "started_date": {
            "type": "string"
          },
          "completed_date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Arbetsmoment kopplade till denna arbetsorder"
    },
    "assigned_to_picking": {
      "type": "string",
      "description": "Tilldelad plockning (email)"
    },
    "assigned_to_picking_name": {
      "type": "string",
      "description": "Tilldelad plockning (namn)"
    },
    "assigned_to_production": {
      "type": "string",
      "description": "Tilldelad produktion/teknik (email)"
    },
    "assigned_to_production_name": {
      "type": "string",
      "description": "Tilldelad produktion/teknik (namn)"
    },
    "technician_name": {
      "type": "string",
      "description": "Ansvarig tekniker"
    },
    "technician_phone": {
      "type": "string",
      "description": "Teknikers telefon"
    },
    "delivery_contact_name": {
      "type": "string",
      "description": "Leveranskontakt namn"
    },
    "delivery_contact_phone": {
      "type": "string",
      "description": "Leveranskontakt telefon"
    },
    "project_description": {
      "type": "string",
      "description": "Tydlig projektbeskrivning"
    },
    "picking_started_date": {
      "type": "string",
      "format": "date-time"
    },
    "picking_completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "production_started_date": {
      "type": "string",
      "format": "date-time"
    },
    "production_completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "p\u00e5b\u00f6rjad",
        "p\u00e5g\u00e5r",
        "monterad",
        "testad",
        "klar"
      ],
      "default": "p\u00e5b\u00f6rjad"
    },
    "checklist": {
      "type": "object",
      "properties": {
        "picked": {
          "type": "boolean",
          "default": false,
          "description": "Plockat"
        },
        "assembled": {
          "type": "boolean",
          "default": false,
          "description": "Monterat"
        },
        "tested": {
          "type": "boolean",
          "default": false,
          "description": "Testat"
        },
        "packed": {
          "type": "boolean",
          "default": false,
          "description": "Paketerat"
        },
        "ready_for_delivery": {
          "type": "boolean",
          "default": false,
          "description": "Redo f\u00f6r leverans"
        }
      }
    },
    "assembly_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "string",
      "description": "Avvikelser"
    },
    "picking_notes": {
      "type": "string",
      "description": "Plockanteckningar"
    },
    "production_notes": {
      "type": "string",
      "description": "Produktionsanteckningar"
    },
    "priority": {
      "type": "string",
      "enum": [
        "l\u00e5g",
        "normal",
        "h\u00f6g",
        "br\u00e5dskande"
      ],
      "default": "normal"
    },
    "drawing_url": {
      "type": "string",
      "description": "L\u00e4nk till ritning"
    },
    "bill_of_materials_url": {
      "type": "string",
      "description": "L\u00e4nk till stycklista (BOM)"
    },
    "materials_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "in_stock": {
            "type": "number",
            "default": 0
          },
          "missing": {
            "type": "number",
            "default": 0
          },
          "needs_purchase": {
            "type": "boolean",
            "default": false
          },
          "serial_number": {
            "type": "string",
            "description": "Serienummer f\u00f6r sp\u00e5rning"
          }
        }
      },
      "description": "Lista \u00f6ver beh\u00f6vda material och deras status"
    },
    "all_materials_ready": {
      "type": "boolean",
      "default": false,
      "description": "Indikerar om alla material \u00e4r tillg\u00e4ngliga"
    },
    "quality_report_url": {
      "type": "string",
      "description": "L\u00e4nk till kvalitetsrapport"
    },
    "test_protocol_url": {
      "type": "string",
      "description": "L\u00e4nk till testprotokoll"
    },
    "needs_procurement": {
      "type": "boolean",
      "default": false,
      "description": "Indikerar om n\u00e5got material beh\u00f6ver k\u00f6pas in"
    },
    "planned_start_date": {
      "type": "string",
      "format": "date",
      "description": "Planerat startdatum"
    },
    "planned_deadline": {
      "type": "string",
      "format": "date",
      "description": "Planerad deadline"
    },
    "signed_off_by": {
      "type": "string",
      "description": "Godk\u00e4nt av (email)"
    },
    "signed_off_date": {
      "type": "string",
      "format": "date-time",
      "description": "Godk\u00e4nnandedatum"
    },
    "total_items": {
      "type": "number",
      "description": "Totalt antal artiklar"
    },
    "total_weight_kg": {
      "type": "number",
      "description": "Total vikt i kg"
    },
    "total_volume_m3": {
      "type": "number",
      "description": "Total volym i m\u00b3"
    },
    "uploaded_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "description": "Uppladdade filer kopplade till denna arbetsorder"
    }
  },
  "required": [
    "order_id"
  ]
}