{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Referens till Order"
    },
    "order_number": {
      "type": "string",
      "description": "Ordernummer (kopierat fr\u00e5n Order)"
    },
    "customer_name": {
      "type": "string",
      "description": "Kundnamn (kopierat fr\u00e5n Order)"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Leveransdatum (kopierat fr\u00e5n Order)"
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "picking",
        "production",
        "delivery",
        "completed"
      ],
      "default": "picking",
      "description": "Nuvarande fas i arbetsordern"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "\u00d6vergripande status"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          },
          "assigned_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ],
            "default": "pending"
          },
          "type": {
            "type": "string",
            "enum": [
              "buy",
              "manufacture",
              "assemble"
            ],
            "default": "assemble",
            "description": "Typ av arbetsmoment"
          },
          "started_date": {
            "type": "string"
          },
          "completed_date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Arbetsmoment kopplade till denna arbetsorder"
    },
    "assigned_to_picking": {
      "type": "string",
      "description": "Tilldelad plockning (email)"
    },
    "assigned_to_picking_name": {
      "type": "string",
      "description": "Tilldelad plockning (namn)"
    },
    "assigned_to_production": {
      "type": "string",
      "description": "Tilldelad produktion (email)"
    },
    "assigned_to_production_name": {
      "type": "string",
      "description": "Tilldelad produktion (namn)"
    },
    "picking_started_date": {
      "type": "string",
      "format": "date-time"
    },
    "picking_completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "production_started_date": {
      "type": "string",
      "format": "date-time"
    },
    "production_completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "started",
        "in_progress",
        "assembled",
        "tested",
        "completed"
      ],
      "default": "started"
    },
    "checklist": {
      "type": "object",
      "properties": {
        "assembled": {
          "type": "boolean",
          "default": false
        },
        "tested": {
          "type": "boolean",
          "default": false
        },
        "ready_for_delivery": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "assembly_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "string"
    },
    "picking_notes": {
      "type": "string"
    },
    "production_notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "drawing_url": {
      "type": "string",
      "description": "L\u00e4nk till ritning"
    },
    "bill_of_materials_url": {
      "type": "string",
      "description": "L\u00e4nk till stycklista (BOM)"
    },
    "materials_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "in_stock": {
            "type": "number",
            "default": 0
          },
          "missing": {
            "type": "number",
            "default": 0
          },
          "needs_purchase": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Lista \u00f6ver beh\u00f6vda material och deras status"
    },
    "all_materials_ready": {
      "type": "boolean",
      "default": false,
      "description": "Indikerar om alla material \u00e4r tillg\u00e4ngliga"
    },
    "quality_report_url": {
      "type": "string",
      "description": "L\u00e4nk till kvalitetsrapport"
    },
    "test_protocol_url": {
      "type": "string",
      "description": "L\u00e4nk till testprotokoll"
    },
    "needs_procurement": {
      "type": "boolean",
      "default": false,
      "description": "Indikerar om n\u00e5got material beh\u00f6ver k\u00f6pas in"
    }
  },
  "required": [
    "order_id"
  ]
}