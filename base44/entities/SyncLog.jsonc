{
  "name": "SyncLog",
  "type": "object",
  "properties": {
    "sync_type": {
      "type": "string",
      "description": "Typ av synk (t.ex. articles_from_fortnox, customers_with_fortnox)"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "error"
      ],
      "description": "Resultatstatus"
    },
    "records_processed": {
      "type": "number",
      "description": "Antal poster behandlade"
    },
    "records_created": {
      "type": "number",
      "description": "Antal poster skapade"
    },
    "records_updated": {
      "type": "number",
      "description": "Antal poster uppdaterade"
    },
    "records_skipped": {
      "type": "number",
      "description": "Antal poster hoppade \u00f6ver"
    },
    "error_message": {
      "type": "string",
      "description": "Felmeddelande om synken misslyckades"
    },
    "details": {
      "type": "object",
      "description": "Extra detaljer om synken"
    },
    "triggered_by": {
      "type": "string",
      "description": "Vem som triggade synken (email eller 'system')"
    }
  },
  "required": [
    "sync_type",
    "status"
  ]
}